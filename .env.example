# Copier ce fichier en .env.local pour le dev, et renseigner les mêmes
# variables dans Vercel > Settings > Environment Variables pour la prod.

OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Intégration Notion (voir README.md > Schéma Notion)
NOTION_TOKEN=
NOTION_DB_ARTICLES=
NOTION_DB_POSTS=

# Seuil de pertinence par défaut = 8 si non renseigné
SEUIL_PERTINENCE=8

# Secret partagé avec Vercel Cron pour sécuriser /api/veille/run
CRON_SECRET=
